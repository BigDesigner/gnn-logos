{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "gnn-logos/showcase",
    "version": "2.0.1",
    "title": "GNN Logos",
    "category": "media",
    "icon": "images-alt2",
    "description": "Logo, referans ve kalite sertifikalarını karusel, sonsuz şerit (marquee) veya responsive ızgara düzeninde sergiler.",
    "keywords": ["logo", "logos", "sertifika", "marquee", "carousel", "referans"],
    "textdomain": "gnn-logos",
    "supports": {
        "align": ["wide", "full"],
        "html": false
    },
    "attributes": {
        "group": { "type": "string", "default": "" },
        "layout": { "type": "string", "default": "carousel" },
        "style": { "type": "string", "default": "minimal" },
        "theme": { "type": "string", "default": "light" },
        "logo_filter": { "type": "string", "default": "none" },
        "columns": { "type": "number", "default": 4 },
        "columns_tablet": { "type": "number", "default": 3 },
        "columns_mobile": { "type": "number", "default": 2 },
        "aspect_ratio": { "type": "string", "default": "auto" },
        "logo_height": { "type": "string", "default": "" },
        "item_width": { "type": "string", "default": "" },
        "gap": { "type": "string", "default": "20px" },
        "autoplay": { "type": "boolean", "default": true },
        "autoplay_speed": { "type": "number", "default": 3000 },
        "speed": { "type": "string", "default": "25s" },
        "direction": { "type": "string", "default": "left" },
        "fade_edges": { "type": "boolean", "default": true },
        "arrows": { "type": "boolean", "default": true },
        "dots": { "type": "boolean", "default": false },
        "pause_on_hover": { "type": "boolean", "default": true },
        "lightbox": { "type": "boolean", "default": false },
        "show_code": { "type": "boolean", "default": true },
        "badges_layout": { "type": "string", "default": "wrap" },
        "badges_align": { "type": "string", "default": "center" },
        "badges_valign": { "type": "string", "default": "bottom" },
        "show_title": { "type": "boolean", "default": false },
        "show_desc": { "type": "boolean", "default": false },
        "limit": { "type": "number", "default": -1 },
        "orderby": { "type": "string", "default": "menu_order" },
        "order": { "type": "string", "default": "ASC" }
    },
    "editorScript": "gnn-logos-block-editor",
    "style": "gnn-logos-frontend"
}
